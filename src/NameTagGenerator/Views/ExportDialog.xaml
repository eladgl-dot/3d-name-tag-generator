<Window x:Class="NameTagGenerator.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
        <RadioButton x:Name="Together" GroupName="Mode" IsChecked="True" Margin="0,0,0,4" Checked="OnChoice">
            <TextBlock x:Name="TogetherText" TextWrapping="Wrap" />
        </RadioButton>
        <RadioButton x:Name="Separate" GroupName="Mode" Margin="0,0,0,12" Checked="OnChoice">
            <TextBlock x:Name="SeparateText" TextWrapping="Wrap" />
        </RadioButton>
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,24" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button x:Name="Confirm" Content="Export" IsDefault="True" MinWidth="88" Click="OnConfirm"
                    Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
