<Window x:Class="NameTagGenerator.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help - 3D name tag generator" Width="720" Height="520" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TopicColumn" Width="210" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Topics" DisplayMemberPath="Title" SelectionChanged="OnTopicChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                <TextBlock x:Name="Body" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
