<UserControl x:Class="NameTagGenerator.Views.ColourPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="6" BorderThickness="1" BorderBrush="#55000000" Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="Opener" Padding="6,3" MinWidth="0" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Title, ElementName=Root}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=PalettePopup, Converter={StaticResource Not}}">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Chip" Width="20" Height="20" CornerRadius="5" BorderThickness="1" BorderBrush="#55000000" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label, ElementName=Root}" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=Opener}" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=Opener, Mode=TwoWay}">
            <Border Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="#33808080" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    TextElement.Foreground="{Binding Foreground, ElementName=Root}">
                <StackPanel>
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" Margin="3,0,3,8" />
                    <ItemsControl x:Name="Swatches">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}" Click="OnSwatchClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Any colour…" Margin="3,8,3,0" HorizontalAlignment="Stretch" Click="OnAnyColourClick" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
