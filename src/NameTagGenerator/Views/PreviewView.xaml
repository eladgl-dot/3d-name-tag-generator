<UserControl x:Class="NameTagGenerator.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Surface" Background="{DynamicResource ViewportBrush}" ClipToBounds="True"
          MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseMove="OnMouseMove" MouseWheel="OnMouseWheel">
        <Viewport3D x:Name="View" IsHitTestVisible="False">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" FieldOfView="35" UpDirection="0,0,1" NearPlaneDistance="1" FarPlaneDistance="20000" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#6A6A6A" />
                        <DirectionalLight Color="#B0B0B0" Direction="-0.4,0.6,-1" />
                        <DirectionalLight Color="#4A4A4A" Direction="0.6,-0.2,-0.5" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="ModelHolder" />
        </Viewport3D>
    </Grid>
</UserControl>
