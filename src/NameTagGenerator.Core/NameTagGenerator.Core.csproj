<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NameTagGenerator</RootNamespace>
    <AssemblyName>NameTagGenerator.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="LibTessDotNet" Version="1.1.15" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\fonts\*.ttf;..\..\assets\fonts\*.otf" LogicalName="font:%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\emoji\NotoEmoji-Bold.ttf" LogicalName="emoji:NotoEmoji-Bold.ttf" />
  </ItemGroup>

</Project>
