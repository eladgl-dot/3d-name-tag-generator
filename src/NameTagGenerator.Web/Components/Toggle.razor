<label class="switch">
    <input type="checkbox" role="switch" checked="@Value" @onchange="Changed" />
    <span>@Label</span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    Task Changed(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is true);
}
