@* One setting on screen, shaped by its Field the same way the desktop app's panel is. *@
@switch (Field.Kind)
{
    case FieldKind.Toggle:
        <Toggle Label="@Field.Label" Value="@(Settings[Field.Key] != 0)" ValueChanged="@(v => Set(v ? 1 : 0))" />
        break;
    case FieldKind.Choice:
        <label>
            @Field.Label
            <select value="@((int)Settings[Field.Key])" @onchange="@(e => Set(int.Parse(e.Value!.ToString()!)))">
                @{ var choices = Field.Choices ?? Array.Empty<string>(); }
                @for (var i = 0; i < choices.Length; i++)
                {
                    <option value="@i">@choices[i]</option>
                }
            </select>
        </label>
        break;
    default:
        <NumberField Label="@Field.Label" Value="@Settings[Field.Key]" Min="@Field.Min" ValueChanged="@Set" />
        break;
}

@code {
    [Parameter, EditorRequired] public Field Field { get; set; } = default!;
    [Parameter, EditorRequired] public ItemSettings Settings { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }

    Task Set(double value)
    {
        Settings.Values[Field.Key] = value;
        return Changed.InvokeAsync();
    }
}
